{
  "name": "enduraw_website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/images.mjs",
    "dev": "vite",
    "start": "vite",
    "prebuild": "node scripts/images.mjs",
    "build": "tsc --noEmit && eslint . --max-warnings 0 && vite build && vite build --ssr src/entry-server.tsx --outDir build-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/images.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "clsx": "^2.1.1",
    "i18next": "^26.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.6",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.25.12": true
  }
}
